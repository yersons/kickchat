# Copia este archivo como ".env" y rellénalo.
# Credenciales de tu app en https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Debe ser EXACTAMENTE la misma URL que registraste en Kick como Redirect URI
KICK_REDIRECT_URI=https://chat.yerson.site/callback
# El servidor solo escucha en local; Caddy/Nginx lo publica con HTTPS
HOST=127.0.0.1
PORT=8765
# Tu usuario de Kick (dueño de la app). Con él verás el botón "Insignias (dueño)" en el menú.
# Si hay varios, sepáralos con coma.
ADMIN_USERS=jersons0
